{
  "services": {
    "backend": {
      "cwd": "backend",
      "buildCommand": "npm install",
      "startCommand": "npm start",
      "port": 3000,
      "environment": [
        "PORT=3000",
        "NODE_ENV=production"
      ]
    },
    "frontend": {
      "cwd": "frontend",
      "buildCommand": "npm install && npm run build",
      "startCommand": "npm run preview",
      "port": 3000,
      "environment": [
        "VITE_ENV=production"
      ]
    }
  },
  "build": {
    "builder": "nixpacks"
  }
}
